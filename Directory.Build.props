<Project>
  <!-- Shared Valheim build settings (SDK pin is global.json). build\Valheim.Build.props, build\Polyfills.cs.txt
       and global.json are canonical copies from UberMorgott/Valheim-Tools-Autotest valbuild/: never edit them
       here, run `valbuild sync .`; `valbuild check .` (quality-gate) fails on drift. -->
  <Import Project="$(MSBuildThisFileDirectory)build\Valheim.Build.props" />

  <!-- RuneSkin-wide (the canonical props leave these per repo). TargetFramework is set in each csproj. -->
  <PropertyGroup>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- CS1591 only on the plugin: its internals are not public API (set in RuneSkin.csproj). -->
  </PropertyGroup>
</Project>
