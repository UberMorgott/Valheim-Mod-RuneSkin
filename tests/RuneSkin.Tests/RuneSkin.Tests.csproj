<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure-logic tests (no Unity runtime): API registration replay, theme schema validation, colour parsing.
       net10.0 because the game's Unity 6 assemblies target netstandard2.1 (not loadable on .NET Framework);
       the tested sources are compiled in directly (they are managed-only by design). -->
  <PropertyGroup>
    <!-- xUnit v3 on Microsoft Testing Platform (build\Valheim.Build.props tests layer). -->
    <OutputType>Exe</OutputType>
    <ValheimTests>true</ValheimTests>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- The linked sources ship on net472, where ArgumentNullException.ThrowIfNull (CA1510) and span overloads of
         uint.Parse (CA1846) do not exist; these net10-only suggestions cannot be applied to them. -->
    <NoWarn>$(NoWarn);CA1510;CA1846</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\RuneSkin.API\Skin.cs" Link="Linked\Skin.cs" />
