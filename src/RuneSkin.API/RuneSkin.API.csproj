<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tiny typed API other mods reference softly (no BepInPlugin here). Only BCL, Unity and game types at the
       boundary. Versioned separately from the plugin: bump ApiVersion on any public surface change. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>RuneSkin.API</AssemblyName>
    <RootNamespace>RuneSkin.API</RootNamespace>
    <Version>2.7.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RuneSkin" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="assembly_valheim">
      <HintPath>$(ManagedDir)\assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
