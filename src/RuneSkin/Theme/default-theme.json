{
  "schema": 1,
  "name": "RuneSkin Stone",
  "bundle": "runeskin",
  "colors": [
    { "token": "color.frame", "value": "#FFFFFFFF" },
    { "token": "color.glass", "value": "#FFFFFFF2" },
    { "token": "color.scrim", "value": "#04070ACC" },
    { "token": "color.ornament", "value": "#FFFFFFFF" },
    { "token": "color.text.body", "value": "#D9D4C7FF" },
    { "token": "color.text.header", "value": "#E9C46AFF" },
    { "token": "color.text.label", "value": "#FFFFFFFF" },
    { "token": "color.text.accent", "value": "#52E0F0FF" },
    { "token": "color.state.normal", "value": "#D9D4C7FF" },
    { "token": "color.state.hover", "value": "#52E0F0FF" },
    { "token": "color.state.pressed", "value": "#3FB7C6FF" },
    { "token": "color.state.selected", "value": "#52E0F0FF" },
    { "token": "color.state.disabled", "value": "#7B7F80FF" },
    { "token": "color.glow", "value": "#52E0F0CC" }
  ],
  "sprites": [
    { "token": "sprite.frame.panel", "asset": "frame_panel" },
    { "token": "sprite.button.normal", "asset": "button_normal" },
    { "token": "sprite.button.hover", "asset": "button_hover" },
    { "token": "sprite.button.pressed", "asset": "button_pressed" },
    { "token": "sprite.button.selected", "asset": "button_selected" },
    { "token": "sprite.button.disabled", "asset": "button_disabled" },
    { "token": "sprite.frame.tooltip", "asset": "tooltip_frame" },
    { "token": "sprite.fill.glass", "asset": "fill_glass" },
    { "token": "sprite.divider", "asset": "divider" },
    { "token": "sprite.ornament.knot", "asset": "knot" },
    { "token": "sprite.frame.panel.glow", "asset": "frame_panel_glow" },
    { "token": "sprite.corner.tl", "asset": "frame_panel_corner_tl" },
    { "token": "sprite.corner.tr", "asset": "frame_panel_corner_tr" },
    { "token": "sprite.corner.bl", "asset": "frame_panel_corner_bl" },
    { "token": "sprite.corner.br", "asset": "frame_panel_corner_br" },
    { "token": "sprite.plaque.header", "asset": "header_plaque" }
  ],
  "fonts": [
    { "token": "font.display", "asset": "RuneSkin-Display Cormorant-Bold SDF" },
    { "token": "font.body", "asset": "RuneSkin-Body PTSans-Regular SDF" }
  ],
  "floats": [
    { "token": "size.tooltip.padding", "value": 12 },
    { "token": "size.tooltip.panel.pad", "value": 0 },
    { "token": "size.panel.pad", "value": 40 },
    { "token": "size.panel.glass.inset", "value": 11.5 },
    { "token": "size.plaque.width", "value": 160 },
    { "token": "size.plaque.height", "value": 36 },
    { "token": "size.text.header.min", "value": 28 },
    { "token": "floor.text.body.px", "value": 16 },
    { "token": "floor.text.number.px", "value": 14 }
  ],
  "roles": [
    { "role": "panel", "sprite": "sprite.frame.panel", "color": "color.frame", "imageType": "Tiled", "fillCenter": "false" },
    { "role": "backdrop", "sprite": "sprite.fill.glass", "color": "color.glass", "imageType": "Sliced", "fillCenter": "true" },
    { "role": "scrim", "color": "color.scrim" },
    { "role": "divider", "sprite": "sprite.divider", "color": "color.ornament", "imageType": "Sliced" },
    { "role": "ornament.knot", "sprite": "sprite.ornament.knot", "keepColor": true, "preserveAspect": true, "imageType": "Simple" },
    { "role": "button", "sprite": "sprite.button.normal", "color": "color.frame", "imageType": "Sliced", "fillCenter": "true",
      "spriteHover": "sprite.button.hover", "spritePressed": "sprite.button.pressed",
      "spriteSelected": "sprite.button.selected", "spriteDisabled": "sprite.button.disabled" },
    { "role": "button.label", "font": "font.display", "textColor": "color.text.body" },
    { "role": "menu.entry", "font": "font.display", "textColor": "color.text.label",
      "stateNormal": "color.state.normal", "stateHover": "color.state.hover", "statePressed": "color.state.pressed",
      "stateSelected": "color.state.selected", "stateDisabled": "color.state.disabled" },
    { "role": "text.header", "font": "font.display", "textColor": "color.text.header" },
    { "role": "text.body", "font": "font.body", "textColor": "color.text.body" },
    { "role": "tooltip.box", "sprite": "sprite.fill.glass", "color": "color.glass", "imageType": "Sliced", "fillCenter": "true" },
    { "role": "tooltip.bare", "sprite": "sprite.frame.tooltip", "color": "color.frame", "imageType": "Sliced", "fillCenter": "true" },
    { "role": "decor.glass", "sprite": "sprite.fill.glass", "color": "color.glass", "imageType": "Sliced", "fillCenter": "true" },
    { "role": "decor.frame", "sprite": "sprite.frame.panel", "color": "color.frame", "imageType": "Tiled", "fillCenter": "false" },
    { "role": "decor.glow", "sprite": "sprite.frame.panel.glow", "color": "color.glow", "imageType": "Tiled", "fillCenter": "false" },
    { "role": "decor.corner.tl", "sprite": "sprite.corner.tl", "color": "color.frame", "imageType": "Simple" },
    { "role": "decor.corner.tr", "sprite": "sprite.corner.tr", "color": "color.frame", "imageType": "Simple" },
    { "role": "decor.corner.bl", "sprite": "sprite.corner.bl", "color": "color.frame", "imageType": "Simple" },
    { "role": "decor.corner.br", "sprite": "sprite.corner.br", "color": "color.frame", "imageType": "Simple" },
    { "role": "decor.plaque", "sprite": "sprite.plaque.header", "color": "color.frame", "imageType": "Tiled", "fillCenter": "true" },
    { "role": "tooltip.topic", "font": "font.display", "textColor": "color.text.header" },
    { "role": "tooltip.text", "font": "font.body", "textColor": "color.text.body" },
    { "role": "content" },
    { "role": "skip" }
  ],
  "spriteRoles": [
    { "match": "woodpanel_400_tileable", "role": "tooltip.box", "context": "Tooltips" },
    { "match": "Background", "role": "tooltip.box", "context": "Tooltips" },
    { "match": "woodpanel_*", "role": "panel" },
    { "match": "panel_bkg_128", "role": "backdrop" },
    { "match": "panel_interior_bkg_128", "role": "backdrop" },
    { "match": "item_background", "role": "backdrop" },
    { "match": "TextBackdrop", "role": "backdrop" },
    { "match": "button", "role": "button" },
    { "match": "BraidLineHorisontalMedium", "role": "divider" },
    { "match": "panel_separator", "role": "divider" },
    { "match": "BraidKnotMedium", "role": "ornament.knot" },
    { "match": "darken_blob", "role": "scrim" },
    { "match": "point", "role": "scrim" },
    { "match": "point 1", "role": "scrim" },
    { "match": "mail", "role": "content" }
  ],
  "families": [
    { "family": "Menu", "requires": [ "sprite.frame.panel", "sprite.fill.glass", "sprite.button.normal", "font.display", "font.body" ] },
    { "family": "Tooltips", "requires": [ "sprite.fill.glass", "sprite.frame.panel", "sprite.frame.tooltip", "font.display", "font.body" ] }
  ]
}
